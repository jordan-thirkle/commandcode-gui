{
  "name": "commandcode-gui",
  "version": "0.1.0",
  "private": true,
  "description": "Native desktop GUI for Command Code, with a Gauntlet Studio for the DUSTLINE game-dev loop.",
  "type": "module",
  "main": "dist/main/electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && tsc -p tsconfig.main.json && node scripts/copy-assets.mjs && vite build",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "electron": "^35.0.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0"
  }
}
