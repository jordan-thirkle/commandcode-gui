{
  "name": "commandcode-gui",
  "version": "0.1.0",
  "private": true,
  "description": "Native desktop GUI for Command Code, with a Gauntlet Studio for the DUSTLINE game-dev loop.",
  "type": "module",
  "main": "dist/main/electron/main.js",
  "license": "MIT",
  "keywords": [
    "command-code",
    "ai",
    "gui",
    "electron",
    "react",
    "coding-agent",
    "gauntlet"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jordan-thirkle/commandcode-gui.git"
  },
  "bugs": {
    "url": "https://github.com/jordan-thirkle/commandcode-gui/issues"
  },
  "homepage": "https://github.com/jordan-thirkle/commandcode-gui#readme",
  "build": {
    "appId": "ai.commandcode.gui",
    "productName": "Command Code GUI",
    "artifactName": "commandcode-gui-${version}-${os}-${arch}",
    "directories": { "output": "release" },
    "files": ["dist/**/*"],
    "asar": false,
    "mac": { "target": ["dmg", "zip"], "category": "public.app-category.developer-tools" },
    "win": { "target": "nsis" },
    "nsis": { "oneClick": false, "allowToWindowDesktop": true },
    "linux": { "target": ["AppImage", "deb"] },
    "publish": null
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && tsc -p tsconfig.main.json && node scripts/copy-assets.mjs && vite build",
    "dist": "npx --yes electron-builder@^26 --publish=never",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "npm run build && node tests/smoke-compiled-main.mjs && node tests/bridge-e2e.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0",
    "typescript": "^7.0.2",
    "vite": "^6.3.0",
    "vitest": "^3.2.0"
  }
}
